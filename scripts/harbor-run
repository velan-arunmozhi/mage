#!/usr/bin/env bash
# Run Harbor with a two-hour agent timeout.
#
# `harbor run --agent` rebuilds the agent list and drops override_timeout_sec.
# This wrapper applies that timeout to the config Harbor is about to validate.
# The verifier timeout stays at the value in the task file.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
harbor_bin="$(command -v harbor)" || {
  echo "harbor is not on PATH." >&2
  exit 127
}
shebang="$(head -n 1 "$harbor_bin")"
python="${shebang#\#!}"
python="${python%% *}"
[[ -n "$python" && -x "$python" ]] || {
  echo "Could not read the Python interpreter from ${harbor_bin}." >&2
  exit 127
}

exec "$python" - "$SCRIPT_DIR" "$@" <<'PY'
import sys
from pathlib import Path

sys.path.insert(0, str(Path(sys.argv[1]) / "lib"))
import mage_scholar
from harbor.models.job.config import JobConfig

_validate = JobConfig.model_validate.__func__


def validate(cls, obj, *args, **kwargs):
    if isinstance(obj, dict):
        mage_scholar.apply_harbor_agent_timeout(obj)
    return _validate(cls, obj, *args, **kwargs)


JobConfig.model_validate = classmethod(validate)
from harbor.cli.main import app

sys.argv = ["harbor", *sys.argv[2:]]
raise SystemExit(app())
PY
